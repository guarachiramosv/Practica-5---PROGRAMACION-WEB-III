@model IEnumerable<practica5PR.Models.Estante>

@{
    ViewData["Title"] = "Estantes de la Farmacia";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold mb-0 text-primary">Estantes</h1>
        <p class="text-muted">Organización física de los medicamentos.</p>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Estante
        </a>
    }
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Nombre / Código</th>
                        <th>Ubicación</th>
                        <th>Descripción</th>
                        <th class="text-center">Medicamentos</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-primary">@item.Nombre</td>
                            <td><i class="bi bi-geo-alt me-1 text-muted"></i>@item.Ubicacion</td>
                            <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                            <td class="text-center">@item.Medicamentos.Count</td>
                            <td class="pe-4 text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="button" class="btn btn-outline-danger" title="Eliminar" onclick="confirmarEliminacion(event, '¿Eliminar estante?', 'Se eliminará el estante físico y sus registros.')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-layout-three-columns display-1 text-muted"></i>
        <p class="mt-3 fs-5">No hay estantes registrados.</p>
    </div>
}
