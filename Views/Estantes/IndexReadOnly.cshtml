@model IEnumerable<practica5PR.Models.Estante>

@{
    ViewData["Title"] = "Estantes de la Farmacia";
}

<div class="mb-4">
    <h1 class="display-6 fw-bold mb-0 text-primary">Estantes</h1>
    <p class="text-muted">Lista de estantes disponibles para la organización de productos.</p>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Nombre / Código</th>
                        <th>Ubicación</th>
                        <th>Descripción</th>
                        <th class="text-center">Medicamentos</th>
                        <th class="pe-4 text-end">Detalles</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-primary">@item.Nombre</td>
                            <td><i class="bi bi-geo-alt me-1 text-muted"></i>@item.Ubicacion</td>
                            <td>@(string.IsNullOrEmpty(item.Descripcion) ? "-" : item.Descripcion)</td>
                            <td class="text-center">@item.Medicamentos.Count</td>
                            <td class="pe-4 text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
