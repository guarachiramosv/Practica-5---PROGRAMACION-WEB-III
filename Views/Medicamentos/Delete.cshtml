@model practica5PR.Models.Medicamento

@{
    ViewData["Title"] = "Eliminar Medicamento";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Medicamentos</a></li>
                <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 mt-3 border-top border-danger border-5">
            <div class="card-body p-4 text-center">
                <i class="bi bi-exclamation-octagon text-danger display-1 mb-3"></i>
                <h3 class="fw-bold">¿Eliminar Medicamento?</h3>
                <p class="text-muted fs-5 mb-4">
                    Estás a punto de eliminar <strong>@Model.Nombre</strong>.<br />
                    Esta acción no se puede deshacer.
                </p>

                <div class="bg-light p-3 rounded mb-4 text-start">
                    <div class="row">
                        <div class="col-6">
                            <span class="text-muted small fw-bold text-uppercase">Precio:</span>
                            <p class="mb-0 fw-medium">@Model.Precio.ToString("C")</p>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small fw-bold text-uppercase">Stock:</span>
                            <p class="mb-0 fw-medium">@Model.Stock Unidades</p>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg shadow-sm">
                            <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                        </button>
                        <a asp-action="Index" class="btn btn-light border btn-lg">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
