@model IEnumerable<practica5PR.Models.Medicamento>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container py-4">
    <div class="row align-items-center mb-5 animate__animated animate__fadeIn">
        <div class="col-lg-7">
            <h1 class="display-4 fw-bold text-primary mb-2">Nuestro Catálogo</h1>
            <p class="lead text-muted">Encuentra los medicamentos y productos de salud que necesitas con la mejor calidad.</p>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-3 bg-primary-subtle rounded-4">
                <form asp-action="Index" method="get" class="row g-2">
                    <div class="col-12">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-start-0 rounded-end-pill" placeholder="Buscar medicamento..." />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4"><i class="bi bi-funnel me-2"></i>Filtros</h5>
                    <form asp-action="Index" method="get">
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Categoría</label>
                            <select name="categoriaId" class="form-select border-0 bg-light rounded-3" asp-items="ViewBag.Categorias" onchange="this.form.submit()">
                                <option value="">Todas</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Ubicación (Estante)</label>
                            <select name="estanteId" class="form-select border-0 bg-light rounded-3" asp-items="ViewBag.Estantes" onchange="this.form.submit()">
                                <option value="">Todos</option>
                            </select>
                        </div>
                        <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill mt-2">
                           Limpiar Filtros
                        </a>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @if (Model.Any())
            {
                <div class="row g-4 animate__animated animate__fadeInUp">
                    @foreach (var item in Model.Where(m => m.Estado))
                    {
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm product-card transition-all overflow-hidden rounded-4">
                                <div class="position-relative overflow-hidden" style="height: 200px;">
                                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                    {
                                        <img src="@item.ImagenUrl" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@item.Nombre">
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                            <i class="bi bi-capsule-pill display-4 text-primary opacity-25"></i>
                                        </div>
                                    }
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-white text-primary shadow-sm rounded-pill px-3 py-2 fw-bold">
                                            Bs. @item.Precio.ToString("N2")
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-4">
                                    <span class="badge bg-primary-subtle text-primary mb-2 rounded-pill px-3">@item.Categoria?.Nombre</span>
                                    <h5 class="card-title fw-bold text-dark mb-2">@item.Nombre</h5>
                                    @if (item.Stock <= 10)
                                    {
                                        <p class="card-text text-danger small mb-3"><i class="bi bi-exclamation-triangle me-1"></i>¡Últimas unidades!</p>
                                    }
                                    else
                                    {
                                        <p class="card-text text-success small mb-3"><i class="bi bi-check-circle me-1"></i>Disponible</p>
                                    }
                                    <div class="d-grid mt-auto">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary rounded-pill py-2">
                                            Ver Detalles
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
                    <i class="bi bi-search display-1 text-muted opacity-25 mb-3"></i>
                    <h3 class="fw-bold">No encontramos resultados</h3>
                    <p class="text-muted">Intenta cambiar los filtros o el término de búsqueda.</p>
                    <a asp-action="Index" class="btn btn-primary rounded-pill mt-3 px-4">Ver todo el catálogo</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .transition-all {
        transition: all 0.3s ease;
    }
</style>
