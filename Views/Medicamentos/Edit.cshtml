@model practica5PR.Models.Medicamento

@{
    ViewData["Title"] = "Editar Medicamento";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Medicamentos</a></li>
                <li class="breadcrumb-item active" aria-current="page">Editar</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-header bg-white py-3">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-2"></i>Editar Medicamento: @Model.Nombre</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImagenUrl" />
                    
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoriaId" class="form-label fw-semibold"></label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId"></select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EstanteId" class="form-label fw-semibold"></label>
                            <select asp-for="EstanteId" class="form-select" asp-items="ViewBag.EstanteId"></select>
                            <span asp-validation-for="EstanteId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Precio" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">Bs.</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" class="form-control" type="number" />
                            <span asp-validation-for="Stock" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="FechaVencimiento" class="form-label fw-semibold"></label>
                            <input asp-for="FechaVencimiento" class="form-control" type="date" />
                            <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Imagen del Producto</label>
                        <div class="d-flex align-items-start gap-3">
                            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                            {
                                <div class="text-center">
                                    <img src="@Model.ImagenUrl" alt="Actual" class="img-thumbnail" style="max-height: 100px;" />
                                    <div class="small text-muted mt-1">Actual</div>
                                </div>
                            }
                            <div class="flex-grow-1">
                                <input type="file" name="imagen" class="form-control" accept="image/*" />
                                <small class="text-muted">Si seleccionas una nueva imagen, la anterior será reemplazada.</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Estado" id="EstadoSwitch">
                            <label class="form-check-label fw-semibold" for="EstadoSwitch">Producto Activo</label>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-light px-4 border">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-5">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
