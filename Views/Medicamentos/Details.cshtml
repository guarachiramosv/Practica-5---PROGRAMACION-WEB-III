@model practica5PR.Models.Medicamento

@{
    ViewData["Title"] = "Detalles del Medicamento";
    var hoy = DateTime.Today;
    var diasParaVencer = (Model.FechaVencimiento - hoy).TotalDays;
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Medicamentos</a></li>
                <li class="breadcrumb-item active" aria-current="page text-primary">Detalles</li>
            </ol>
        </nav>

        <div class="card shadow-sm border-0 mt-3 overflow-hidden">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Información del Medicamento</h4>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-md-4 bg-light p-4 d-flex flex-column align-items-center justify-content-center text-center border-end">
                        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                        {
                            <img src="@Model.ImagenUrl" alt="@Model.Nombre" class="img-fluid rounded shadow-sm mb-4 border" style="max-height: 250px; width: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <i class="bi bi-capsule-pill display-1 text-primary mb-3"></i>
                        }
                        <h3 class="fw-bold text-dark">@Model.Nombre</h3>
                        <span class="badge @(Model.Estado ? "bg-success" : "bg-danger") fs-6 mt-2 shadow-sm">
                            @(Model.Estado ? "Activo" : "Inactivo")
                        </span>
                    </div>
                    <div class="col-md-8 p-5">
                        <h5 class="text-muted border-bottom pb-2 mb-4">Detalles Generales</h5>
                        <div class="row">
                            <div class="col-sm-6 mb-4">
                                <label class="text-muted small text-uppercase fw-bold d-block">Categoría</label>
                                <span class="fs-5 fw-medium text-dark">@Model.Categoria?.Nombre</span>
                            </div>
                            <div class="col-sm-6 mb-4">
                                <label class="text-muted small text-uppercase fw-bold d-block">Ubicación (Estante)</label>
                                <span class="fs-5 fw-medium text-dark">@Model.Estante?.Nombre</span>
                            </div>
                            <div class="col-sm-6 mb-4">
                                <label class="text-muted small text-uppercase fw-bold d-block">Precio Unitario</label>
                                <span class="fs-4 fw-bold text-primary">Bs. @Model.Precio.ToString("N2")</span>
                            </div>
                            <div class="col-sm-6 mb-4">
                                <label class="text-muted small text-uppercase fw-bold d-block">Stock Disponible</label>
                                <span class="fs-4 @(Model.Stock <= 10 ? "text-danger" : "text-success") fw-bold">@Model.Stock Unidades</span>
                                @if (Model.Stock <= 10)
                                {
                                    <span class="d-block text-danger small"><i class="bi bi-exclamation-triangle"></i> ¡Stock Crítico!</span>
                                }
                            </div>
                            <div class="col-sm-6 mb-4">
                                <label class="text-muted small text-uppercase fw-bold d-block">Fecha de Vencimiento</label>
                                <span class="fs-5 fw-medium">@Model.FechaVencimiento.ToString("D")</span>
                                @if (diasParaVencer < 0)
                                {
                                    <span class="d-block text-danger fw-bold small"><i class="bi bi-x-circle"></i> PRODUCTO VENCIDO</span>
                                }
                                else if (diasParaVencer <= 30)
                                {
                                    <span class="d-block text-warning fw-bold small"><i class="bi bi-exclamation-circle"></i> PRÓXIMO A VENCER</span>
                                }
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-light rounded">
                            <label class="text-muted small text-uppercase fw-bold d-block mb-1">Descripción</label>
                            <p class="mb-0">@(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción detallada." : Model.Descripcion)</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white py-3">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Volver al Listado</a>
                    @if (User.IsInRole("Administrador") || User.IsInRole("Farmaceutico"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                            <i class="bi bi-pencil me-1"></i> Editar Información
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
