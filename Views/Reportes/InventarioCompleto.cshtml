@model practica5PR.Models.ViewModels.InventarioViewModel

@{
    ViewData["Title"] = "Inventario Completo";
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h1 class="display-6 fw-bold mb-0 text-primary">Inventario Completo</h1>
        <p class="text-muted">Vista integral de todos los activos críticos y existencias.</p>
    </div>
    <div class="btn-group">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Imprimir Todo
        </button>
        <a asp-controller="Inventario" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4 mb-4 d-print-none">
    <div class="col-md-4">
        <div class="card bg-danger text-white shadow-sm border-0">
            <div class="card-body py-4">
                <h5 class="card-title opacity-75">Vencidos</h5>
                <h2 class="fw-bold">@Model.Vencidos.Count</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-dark shadow-sm border-0">
            <div class="card-body py-4">
                <h5 class="card-title opacity-75">Por Vencer (90d)</h5>
                <h2 class="fw-bold">@(Model.PorVencer30Dias.Count + Model.PorVencer60Dias.Count + Model.PorVencer90Dias.Count)</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white shadow-sm border-0">
            <div class="card-body py-4">
                <h5 class="card-title opacity-75">Stock Bajo</h5>
                <h2 class="fw-bold">@Model.BajoStock.Count</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-5">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">Detalle de Existencias</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Medicamento</th>
                        <th>Categoría</th>
                        <th>Estante</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Vencimiento</th>
                        <th class="pe-4 text-center">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Vencidos.Concat(Model.PorVencer30Dias).Concat(Model.PorVencer60Dias).Concat(Model.PorVencer90Dias).Concat(Model.BajoStock).DistinctBy(m => m.Id))
                    {
                        <tr>
                            <td class="ps-4">@item.Nombre</td>
                            <td>@item.Categoria?.Nombre</td>
                            <td>@item.Estante?.Nombre (@item.Estante?.Ubicacion)</td>
                            <td class="text-center">
                                <span class="@(item.Stock <= 10 ? "text-danger fw-bold" : "")">@item.Stock</span>
                            </td>
                            <td class="text-center">
                                <span class="@(item.FechaVencimiento < DateTime.Today ? "text-danger fw-bold" : "")">
                                    @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                </span>
                            </td>
                            <td class="pe-4 text-center">
                                @if (item.FechaVencimiento < DateTime.Today)
                                {
                                    <span class="badge bg-danger">Vencido</span>
                                }
                                else if (item.Stock <= 10)
                                {
                                    <span class="badge bg-info">Stock Bajo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Alerta Venc.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style nonce="print-style">
    @@media print {
        .navbar, .footer, .btn-group, .d-print-none { display: none !important; }
        .card { box-shadow: none !important; border: 1px solid #eee !important; }
    }
</style>
