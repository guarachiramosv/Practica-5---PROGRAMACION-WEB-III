@model practica5PR.Models.ViewModels.ReporteViewModel

@{
    ViewData["Title"] = Model.Titulo;
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
    <div>
        <h1 class="display-6 fw-bold mb-0 text-primary">@Model.Titulo</h1>
        <p class="text-muted">Generado el: @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="btn-group">
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Imprimir
        </button>
        <a asp-controller="Inventario" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i> Volver al Control
        </a>
    </div>
</div>

<!-- Encabezado para Impresión -->
<div class="d-none d-print-block text-center mb-5">
    <h2 class="fw-bold">Sistema de Gestión de Farmacia</h2>
    <h3>@Model.Titulo</h3>
    <p>Fecha de Reporte: @Model.FechaGeneracion.ToString("f")</p>
    <hr />
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Medicamento</th>
                        <th>Categoría</th>
                        <th>Estante</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Precio</th>
                        <th class="pe-4 text-center">Fecha Venc.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Medicamentos)
                    {
                        <tr>
                            <td class="ps-4 fw-medium">@item.Nombre</td>
                            <td>@item.Categoria?.Nombre</td>
                            <td>@item.Estante?.Nombre</td>
                            <td class="text-center">@item.Stock</td>
                            <td class="text-center">Bs. @item.Precio.ToString("N2")</td>
                            <td class="pe-4 text-center @(Model.Titulo.Contains("Vencid") ? "text-danger fw-bold" : (Model.Titulo.Contains("Vencer") ? "text-warning fw-bold" : ""))">
                                @item.FechaVencimiento.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
                @if (Model.Medicamentos.Any())
                {
                    <tfoot class="bg-light fw-bold">
                        <tr>
                            <td colspan="3" class="ps-4">Total de Registros</td>
                            <td class="text-center">@Model.Medicamentos.Sum(m => m.Stock)</td>
                            <td colspan="2" class="pe-4 text-end">@Model.Medicamentos.Count ítems</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@if (!Model.Medicamentos.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-file-earmark-check display-1 text-muted"></i>
        <p class="mt-3 fs-5">No se encontraron datos para este reporte.</p>
    </div>
}

<style nonce="print-style">
    @@media print {
        body { background-color: white !important; }
        .card { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
        .navbar, .footer, .btn-group, .d-print-none { display: none !important; }
    }
</style>
