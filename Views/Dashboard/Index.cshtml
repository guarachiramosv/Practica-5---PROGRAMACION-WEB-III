@model practica5PR.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="mb-5">
    <h1 class="display-5 fw-bold text-primary mb-2">Bienvenido, @User.Identity?.Name</h1>
    <p class="text-muted fs-5">Resumen general del estado de la farmacia y accesos rápidos.</p>
</div>

<div class="row g-4 mb-5">
    <!-- Card Total Medicamentos -->
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100 shadow-sm border-0 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <i class="bi bi-capsule-pill position-absolute top-0 end-0 m-3 opacity-25" style="font-size: 4rem;"></i>
                <h6 class="text-uppercase opacity-75 small fw-bold">Medicamentos Totales</h6>
                <h1 class="display-4 fw-bold mb-0">@Model.TotalMedicamentos</h1>
                <a asp-controller="Medicamentos" asp-action="Index" class="text-white text-decoration-none small mt-3 d-inline-block">
                    Ver todos <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card Vencidos (Alerta Roja) -->
    <div class="col-md-3">
        <div class="card @(Model.MedicamentosVencidos > 0 ? "bg-danger" : "bg-success") text-white h-100 shadow-sm border-0 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <i class="bi bi-calendar-x position-absolute top-0 end-0 m-3 opacity-25" style="font-size: 4rem;"></i>
                <h6 class="text-uppercase opacity-75 small fw-bold">Vencidos</h6>
                <h1 class="display-4 fw-bold mb-0">@Model.MedicamentosVencidos</h1>
                <a asp-controller="Inventario" asp-action="Index" class="text-white text-decoration-none small mt-3 d-inline-block">
                    Gestionar <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card Bajo Stock -->
    <div class="col-md-3">
        <div class="card @(Model.MedicamentosBajoStock > 0 ? "bg-warning text-dark" : "bg-success text-white") h-100 shadow-sm border-0 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <i class="bi bi-box-seam position-absolute top-0 end-0 m-3 opacity-25" style="font-size: 4rem;"></i>
                <h6 class="text-uppercase opacity-75 small fw-bold">Bajo Stock</h6>
                <h1 class="display-4 fw-bold mb-0">@Model.MedicamentosBajoStock</h1>
                <a asp-controller="Reportes" asp-action="BajoStock" class="text-dark text-decoration-none small mt-3 d-inline-block">
                    Reponer <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Card Por Vencer -->
    <div class="col-md-3">
        <div class="card bg-info text-white h-100 shadow-sm border-0 overflow-hidden">
            <div class="card-body p-4 position-relative">
                <i class="bi bi-clock-history position-absolute top-0 end-0 m-3 opacity-25" style="font-size: 4rem;"></i>
                <h6 class="text-uppercase opacity-75 small fw-bold">Próx. a Vencer</h6>
                <h1 class="display-4 fw-bold mb-0">@Model.MedicamentosPorVencer</h1>
                <a asp-controller="Reportes" asp-action="PorVencer" class="text-white text-decoration-none small mt-3 d-inline-block">
                    Ver Alertas <i class="bi bi-arrow-right-short"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Accesos Directos</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-4 text-center">
                        <a asp-controller="Medicamentos" asp-action="Create" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-plus-circle-fill text-primary fs-3 d-block mb-2"></i>
                            Nuevo Producto
                        </a>
                    </div>
                    <div class="col-6 col-md-4 text-center">
                        <a asp-controller="Categorias" asp-action="Index" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-tags-fill text-success fs-3 d-block mb-2"></i>
                            Categorías
                        </a>
                    </div>
                    <div class="col-6 col-md-4 text-center">
                        <a asp-controller="Estantes" asp-action="Index" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-layout-three-columns text-info fs-3 d-block mb-2"></i>
                            Estantes
                        </a>
                    </div>
                    <div class="col-6 col-md-4 text-center">
                        <a asp-controller="Reportes" asp-action="InventarioCompleto" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-file-earmark-bar-graph text-secondary fs-3 d-block mb-2"></i>
                            Reporte Total
                        </a>
                    </div>
                    <div class="col-6 col-md-4 text-center">
                        <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-person-gear text-dark fs-3 d-block mb-2"></i>
                            Mi Perfil
                        </a>
                    </div>
                    <div class="col-6 col-md-4 text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light w-100 py-3 border">
                            <i class="bi bi-house-door-fill text-muted fs-3 d-block mb-2"></i>
                            Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Estadísticas de Infraestructura</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex justify-content-between align-items-center bg-light rounded mb-2 border-0">
                        <span>Total de Categorías</span>
                        <span class="badge bg-primary rounded-pill">@Model.TotalCategorias</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center bg-light rounded mb-2 border-0">
                        <span>Total de Estantes</span>
                        <span class="badge bg-primary rounded-pill">@Model.TotalEstantes</span>
                    </div>
                </div>
                <div class="alert alert-info border-0 mt-3 mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    La organización por categorías y estantes mejora el tiempo de búsqueda de medicamentos.
                </div>
            </div>
        </div>
    </div>
</div>
